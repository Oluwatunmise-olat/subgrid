  "engines": {
    "node": ">=18.x.x <=22.0.0"
  },
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --external '*'",
    "migrate": "bun node_modules/.bin/knex migrate:latest --knexfile knexfile.ts",
    "migrate:rollback": "bun node_modules/.bin/knex migrate:rollback --knexfile knexfile.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.2.17",
    "@langchain/openai": "^1.6.2",
